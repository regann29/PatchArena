# Model server (vLLM on ROCm exposes an OpenAI-compatible API)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
LLM_API_KEY=EMPTY
N_CANDIDATES=8
# local = run pytest in a temp dir (dev / preloaded samples only)
# docker = run each candidate in a no-network container (see sandbox/Dockerfile)
SANDBOX=local
# Set to 1 to run the whole pipeline with scripted model replies (no GPU needed)
LLM_MOCK=0
# Optional: open real PRs
GITHUB_TOKEN=
